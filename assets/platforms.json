{
  "schema": 1,
  "verified": "2026-10-25",
  "note": "Every number below was read from the official page in its `source`. Providers change limits often: if `verified` is older than 90 days, or a number decides the answer, re-open the source before relying on it. A limit marked `stated: false` was not published on the source page and is left out of the math.",
  "metrics": {
    "requests": "HTTP requests that reach the platform (static + dynamic)",
    "invocations": "function / server-code executions",
    "fn_concurrency": "concurrent function executions at peak",
    "cpu_ms": "CPU milliseconds consumed by functions",
    "active_cpu_hours": "Vercel Fluid active CPU hours",
    "memory_gb_hours": "Vercel Fluid provisioned memory GB-hours (upper bound: no in-instance sharing)",
    "gb_seconds": "function memory x wall time (AWS / Firebase style)",
    "egress_gb": "bytes sent to users, GB",
    "peak_rps": "requests per second at peak",
    "db_qps": "database queries per second at peak",
    "db_backend_conns": "database server connections busy at peak (Little's law)",
    "db_pool_clients": "client connections opened to the pooler/database at peak",
    "db_rows_read": "database rows / documents read",
    "db_rows_written": "database rows / documents written",
    "db_storage_gb": "database size, GB",
    "db_awake_cu_hours": "serverless Postgres compute hours (Neon CU-hours)",
    "realtime_conns": "concurrent realtime / websocket connections at peak",
    "realtime_msgs_per_s": "realtime messages per second at peak",
    "realtime_msgs": "realtime messages",
    "auth_mau": "monthly active users signing in",
    "kv_reads": "key-value reads",
    "kv_writes": "key-value writes",
    "redis_commands": "Redis commands",
    "redis_cmds_per_s": "Redis commands per second at peak",
    "credits": "Netlify credits (requests, bandwidth and compute converted with credit_costs)"
  },
